# ============================================================
# Secrets & credentials — never commit
# ============================================================
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.pfx
*.crt
secrets/
keys/
infra/certs/
web/certs/
# Filled deployment manifests (contain IPs / users / admin creds) — never commit.
# Only the *.example.* templates are versioned.
infra/cluster.json
infra/single.env
infra/org-bootstrap.json
out/
.s3-creds
.pg-creds

