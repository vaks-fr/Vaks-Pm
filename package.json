{
  "name": "vaks-pm",
  "private": true,
  "version": "0.1.0",
  "description": "Outil de gestion de projet on-premise — monorepo",
  "workspaces": [
    "packages/*",
    "api",
    "worker",
    "web",
    "mcp",
    "llm-gateway"
  ],
  "scripts": {
    "dev": "docker compose up",
    "down": "docker compose down",
    "build": "npm run build -w @vaks-pm/shared && npm run build -w @vaks-pm/api && npm run build -w @vaks-pm/worker && npm run build -w @vaks-pm/web && npm run build -w @vaks-pm/mcp",
    "prisma:generate": "npm run prisma:generate -w @vaks-pm/api",
    "prisma:migrate": "npm run prisma:migrate -w @vaks-pm/api",
    "seed": "npm run seed -w @vaks-pm/api"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "rxjs": "7.8.2",
    "ws": "^8.21.0",
    "js-yaml": "^4.3.1",
    "undici": "^7.28.0",
    "multer": "^2.2.0",
    "uuid": "^11.1.1",
    "@hono/node-server": "^2.0.12",
    "body-parser": "^1.20.6",
    "brace-expansion": "2.1.4",
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.5",
    "postcss": "^8.5.25",
    "valibot": "^1.4.2"
  }
}
