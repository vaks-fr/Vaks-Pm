# Sert le build statique du front et proxy /api vers le backend (prod).
# Templated: l'entrypoint nginx:alpine lance envsubst sur ce fichier au démarrage
# et écrit /etc/nginx/conf.d/default.conf. Seul ${API_UPSTREAM} est substitué
# (les variables nginx $host/$remote_addr… ne sont pas des env vars → intactes).
#   - Swarm/dev : API_UPSTREAM=http://api:3000 (défaut posé dans le Dockerfile)
#   - Kubernetes : API_UPSTREAM=http://<release>-vaks-pm-api:3000 (Helm)
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Assets Vite : noms content-hashés (index-<hash>.js) → immutables. Cache long
  # côté navigateur, plus de revalidation à chaque visite. La compression est
  # gérée au bord par Traefik (middleware `compress`).
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # index.html ne doit JAMAIS être mis en cache : c'est lui qui référence les
  # bundles hashés courants — un index.html périmé = chunks introuvables après
  # déploiement (écran blanc). no-store force le navigateur à le re-télécharger.
  location = /index.html {
    add_header Cache-Control "no-store, must-revalidate";
    expires -1;
  }

  # SPA fallback
  location / {
    try_files $uri $uri/ /index.html;
  }
}
