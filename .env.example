# ============================================================
# Template .env.local pour le déploiement on-premise (PROD).
# Pour le dev local (`docker compose up`) : utiliser .env.dev.example.
#
# Usage :
#   cp .env.example .env.local
#   # éditer les valeurs ci-dessous
# ============================================================


# ============================================================
# Infra / SSH — OBLIGATOIRE pour les 2 modes (single et HA)
# ============================================================
VM_USER=
VM_PASS=

# Hôtes cibles. En single : seul VM_HOST1 est utilisé.
VM_HOST1=
VM_HOST2=
VM_HOST3=

# Chemin vers la clé privée OpenSSH utilisée par les scripts SSH.
# Relatif = résolu depuis la racine du repo. Ex: keys/id_ed25519
SSH_KEY=


# ============================================================
# DB / Patroni / JWT — OBLIGATOIRE en HA, IGNORÉ en single.
# Lu uniquement par `out/deploy-ssh.sh` (HA) avant le déploiement.
# En single : laisser vide ; les mots de passe sont choisis directement
# à l'étape « Swarm + secrets » via des commandes copiables.
# ============================================================
POSTGRES_USER=vakspm
# Recommandé : openssl rand -hex 24  (éviter @ : / ? # & % et espaces — DSN URL)
POSTGRES_PASSWORD=
POSTGRES_DB=vakspm

PATRONI_REPLICATION_USER=replicator
PATRONI_REPLICATION_PASSWORD=
PATRONI_SUPERUSER_PASSWORD=

# Recommandé : openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=


# ============================================================
# SMTP — OPTIONNEL (si emails désactivés, laisser SMTP_PASSWORD vide)
# Le host/port/from se règlent ensuite dans l'admin de l'app.
# ============================================================
SMTP_PASSWORD=
