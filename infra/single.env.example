# Setup single-host — copier en infra/single.env (git-ignoré) et remplir.
# Déploiement 1 machine en single-node Swarm (postgres conteneurisé, pas de
# Patroni/etcd/HAProxy natif). Lancé par : bash setup.sh  (choisir "single").

# --- Cible ---
HOST_IP=            # IP/hostname de la machine (advertise-addr Swarm)
SSH_USER=           # user SSH (défaut: $VM_USER de .env.local)
# SSH_KEY hérité de .env.local

# --- App ---
BASE_DOMAIN=        # domaine racine (<slug>.<BASE_DOMAIN>) ; vide = pas de routing par Host
DEPLOYMENT_MODE=pooled    # pooled | dedicated
DB_NAME=vakspm

# --- Secrets (générés si vides au premier run) ---
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
MFA_ENCRYPTION_KEY=       # openssl rand -base64 32

# --- SMTP (optionnel) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
